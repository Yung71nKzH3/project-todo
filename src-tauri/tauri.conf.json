{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Lava Lamp Todo",
    "version": "2.0.0",
    "identifier": "com.lavalamptodo.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:5174",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Lava Lamp Todo",
                "width": 800,
                "height": 600
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon.png",
            "icons/icon.ico"
        ]
    }
}